{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^http://127.0.0.1"
    },
    {
      "pattern": "^.*tmp/.*"
    },
    {
      "pattern": "^https://www\\.linkedin\\.com/.*"
    },
    {
      "pattern": "^https://www\\.ted\\.com/.*"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://", "http://"],
      "headers": {
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check; +https://github.com/tcort/markdown-link-check)",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s"
}
